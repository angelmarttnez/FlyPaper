# Copia este archivo a .env y rellena los valores (nunca subas .env a git).
# Los valores de ejemplo son FICTICIOS: sustitúyelos por los tuyos reales.

# =============================================================================
# SECRET_KEY — ¿qué es?
# =============================================================================
# Es la contraseña secreta con la que Flask FIRMA las cookies de sesión
# (login portal, panel SOC, etc.). No es un usuario ni una API key de un servicio.
# Si alguien la conoce, podría falsificar sesiones.
#
# Cómo generar una (elige una):
#   Linux/macOS/VM:  openssl rand -hex 32
#   PowerShell:      -join ((48..57)+(97..102)|Get-Random -Count 64|%{[char]$_})
#   O cualquier cadena larga aleatoria (≥32 caracteres).
#
# En laboratorio puedes dejar el ejemplo de abajo. En una VM/servidor: cámbiala.
# =============================================================================
SECRET_KEY=lab-solo-ejemplo-genera-una-aleatoria

# =============================================================================
# IA (análisis de ataques y resúmenes diarios) — proveedor activo: Groq
# =============================================================================
# ANTHROPIC_API_KEY queda por compatibilidad; el analizador usa GROQ_API_KEY.
ANTHROPIC_API_KEY=
GROQ_API_KEY=gsk_pega_aqui_tu_clave_de_console_groq_com
# GROQ_MODEL=openai/gpt-oss-20b

# =============================================================================
# Mapa SOC (Leaflet). Opcional. Doc: https://carto.com/basemaps/
# En las URLs de teselas se usa ?key= (no api_key).
# =============================================================================
CARTO_API_KEY=

# =============================================================================
# Tests HTTP (opcional). Si /register da 429, usa una cuenta ya registrada.
# =============================================================================
# FLYPAPER_TEST_USER=Angel
# FLYPAPER_TEST_PASSWORD=tu_password_portal

# =============================================================================
# Telegram (2FA SOC + alertas). Grupo con Topics activados.
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_LOGINS=
TELEGRAM_TOPIC_ATAQUES=
TELEGRAM_TOPIC_RESUMEN=

# =============================================================================
# Reputación IP (opcional). ip-api.com no necesita clave.
# =============================================================================
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SCORE_THRESHOLD=50.0

# =============================================================================
# Perímetro NGWAF (Redis)
# Local (Redis en el host):     redis://127.0.0.1:6379/0
# Docker Compose (servicio):    redis://redis:6379/0  (Compose lo inyecta solo)
# =============================================================================
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_MAX_REQ=60
RATE_LIMIT_WINDOW_SEC=60
RISK_SCORE_AUTOBAN=5
REDIS_BLOCK_TTL=86400
CIRCUIT_BREAKER_FAILS=3
CIRCUIT_BREAKER_OPEN_SEC=3600

# Directorio de SQLite (opcional; por defecto ./data)
# FLYPAPER_DATA_DIR=

# =============================================================================
# Hardening en VM / Internet (recomendado)
# =============================================================================
# FLYPAPER_STRICT_DEPLOY=1
# FLYPAPER_ALLOW_SOC_RECOVERY=0

# Cuenta SOC la PRIMERA vez que la BD privada está vacía.
# Tras login + 2FA debes cambiar usuario y contraseña en /admin/cambiar-password.
INITIAL_SOC_USERNAME=Flypaper
INITIAL_SOC_PASSWORD=Flypaper_123
