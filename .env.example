# Copia este archivo a .env y rellena los valores (nunca subas .env a git).
# Los valores siguientes son FICTICIOS de ejemplo (no son claves reales).

# --- Despliegue VM / Docker (recomendado) ---
# SECRET_KEY= reemplazar por: openssl rand -hex 32
# INITIAL_SOC_PASSWORD= password fuerte ≥12
# FLYPAPER_STRICT_DEPLOY=1
# FLYPAPER_ALLOW_SOC_RECOVERY=0
# REDIS_URL=redis://redis:6379/0   (Compose); en host: redis://127.0.0.1:6379/0

# Firma de cookies Flask
SECRET_KEY=cambia_esta_clave_lab_flypaper_32chars

# IA — análisis de ataques y resúmenes diarios (Groq)
ANTHROPIC_API_KEY=sk-ant-api03-EJEMPLO_NO_USAR_xxxxxxxx
GROQ_API_KEY=gsk_EJEMPLO_NO_USAR_xxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=openai/gpt-oss-20b

# Mapa SOC (Leaflet + CARTO) — https://carto.com/basemaps/  (?key= en teselas)
CARTO_API_KEY=ejemplo_carto_key_no_real

# Tests HTTP (si /register responde 429)
FLYPAPER_TEST_USER=demo_flypaper
FLYPAPER_TEST_PASSWORD=DemoFlyPaper2026!

# Telegram — grupo con Topics (message_thread_id)
TELEGRAM_BOT_TOKEN=0000000000:AAEjemploTokenTelegramNoRealxxxxx
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_TOPIC_LOGINS=1
TELEGRAM_TOPIC_ATAQUES=2
TELEGRAM_TOPIC_RESUMEN=3

# Reputación IP (AbuseIPDB + VirusTotal; ip-api sin key)
ABUSEIPDB_API_KEY=ejemplo_abuseipdb_key_no_real
VIRUSTOTAL_API_KEY=ejemplo_virustotal_key_no_real
SCORE_THRESHOLD=50.0

# Perímetro NGWAF (Redis)
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_MAX_REQ=60
RATE_LIMIT_WINDOW_SEC=60
RISK_SCORE_AUTOBAN=5
REDIS_BLOCK_TTL=86400
CIRCUIT_BREAKER_FAILS=3
CIRCUIT_BREAKER_OPEN_SEC=3600

# FLYPAPER_DATA_DIR=

# Hardening
# FLYPAPER_STRICT_DEPLOY=1
# FLYPAPER_ALLOW_SOC_RECOVERY=0

# Cuenta SOC inicial (solo si flypaper_priv.db está vacía)
INITIAL_SOC_USERNAME=Flypaper
INITIAL_SOC_PASSWORD=Flypaper_123
